# ==============================================================================
# InsightAnalyst .gitignore
# Prevents committing secrets, virtual environments, caches, and local databases.
# ==============================================================================

# Environment files & Secrets (CRITICAL: Never commit API keys)
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Local databases and large data files
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# ChromaDB persistence & vector embeddings
chroma_db/
.chroma/
*.chroma/

# LLM response caches (for zero-quota repeat queries & offline demos)
.cache/
.llm_cache/

# Generated local reports
insightanalyst_report.md

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
