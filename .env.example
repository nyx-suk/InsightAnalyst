# InsightAnalyst Environment Configuration
# Copy this file to .env and fill in your keys. Real keys must never be committed!

# Provider selection: "gemini", "groq", or "ollama"
LLM_PROVIDER=gemini

# Primary free-tier API key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative free-tier API key (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama offline fallback configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# On-disk response cache directory
LLM_CACHE_DIR=.cache/llm
